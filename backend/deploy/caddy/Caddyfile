#Proxy de entrada del server: HTTPS automatico con Let's Encrypt y ruteo por host.
#  {$PLATFORM_DOMAIN}            frontend de la plataforma (alta de tiendas y panel del superadmin)
#  api.{$PLATFORM_DOMAIN}        gateway
#  <tienda>.{$PLATFORM_DOMAIN}   frontend de cada tienda: el certificado se saca la primera vez que alguien entra
#Solo corre en el server (profile server de docker-compose.prod.yml). Variable: PLATFORM_DOMAIN.
#Se monta la carpeta (no el archivo) para que un git checkout se vea adentro; deploy.sh hace caddy reload.
{
	#Antes de sacar el certificado de una tienda, Caddy le pregunta a /check (abajo) si el host es valido
	on_demand_tls {
		ask http://localhost:5555/check
	}
}

#Headers de seguridad de todo lo que se sirve por HTTPS. HSTS sin preload: se puede sacar bajando max-age
(security) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}
}

#El frontend (plataforma y tiendas): ademas, no se puede meter en un iframe y la CSP.
#La CSP va en Report-Only: el navegador avisa en la consola lo que bloquearia, sin bloquearlo. Cuando no aparezcan
#avisos, pasarla a Content-Security-Policy. style-src 'unsafe-inline': sonner y Radix insertan <style> en runtime.
#img-src y frame-src blob: vista previa de imagenes y comprobantes. connect-src wss: el panel en tiempo real (/ws)
(frontend) {
	import security
	header {
		X-Frame-Options "DENY"
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://api.{$PLATFORM_DOMAIN}; font-src 'self' data:; connect-src 'self' https://api.{$PLATFORM_DOMAIN} wss://api.{$PLATFORM_DOMAIN}; frame-src blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}
}

#robots.txt de lo que no es para buscadores: el panel de la plataforma y la API
(noindex) {
	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond <<TXT
			User-agent: *
			Disallow: /
			TXT 200
	}
}

{$PLATFORM_DOMAIN} {
	import frontend
	encode zstd gzip
	import noindex
	handle {
		reverse_proxy frontend:80
	}
}

api.{$PLATFORM_DOMAIN} {
	import security
	encode zstd gzip
	import noindex
	handle {
		reverse_proxy gateway-service:3000
	}
}

#www no es una tienda (es un identificador reservado): va al dominio de la plataforma
www.{$PLATFORM_DOMAIN} {
	redir https://{$PLATFORM_DOMAIN}{uri} permanent
}

#Las tiendas: cualquier otro host. No va como *.{$PLATFORM_DOMAIN} porque ese comodin tapa a api. y Caddy no le
#saca certificado propio; el /check de abajo es el que limita los hosts a <tienda>.{$PLATFORM_DOMAIN}
https:// {
	tls {
		on_demand
	}
	import frontend
	encode zstd gzip

	#Vista previa de un producto compartido: los crawlers no ejecutan JavaScript, asi que /productos/{slug} se les
	#responde con el HTML de Open Graph del gateway (/share/{tienda}/products/{slug}). Las personas abren la SPA
	@preview {
		path_regexp slug ^/productos/([^/]+)/?$
		header_regexp host Host ^([a-z0-9-]+)\.
		header_regexp bot User-Agent (?i)(whatsapp|facebookexternalhit|facebot|meta-externalagent|twitterbot|telegrambot|slackbot|linkedinbot|discordbot|pinterest|skypeuripreview|iframely|embedly|googlebot|bingbot)
	}
	handle @preview {
		rewrite * /share/{re.host.1}/products/{re.slug.1}
		reverse_proxy gateway-service:3000
	}

	#Para los buscadores. El sitemap lo arma products con los productos de la tienda (/share/{tienda}/sitemap.xml en el
	#gateway, como la vista previa). robots.txt deja indexar lo publico y no el panel, el carrito, el checkout ni la
	#cuenta (el frontend tambien les pone noindex)
	@sitemap {
		path /sitemap.xml
		header_regexp host Host ^([a-z0-9-]+)\.
	}
	handle @sitemap {
		rewrite * /share/{re.host.1}/sitemap.xml
		reverse_proxy gateway-service:3000
	}
	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond <<TXT
			User-agent: *
			Allow: /
			Disallow: /admin
			Disallow: /user/
			Disallow: /carrito
			Disallow: /checkout
			Disallow: /pedido
			Disallow: /mis-pedidos
			Disallow: /login
			Disallow: /register
			Disallow: /recuperar
			Disallow: /reset-password

			Sitemap: https://{host}/sitemap.xml
			TXT 200
	}

	handle {
		reverse_proxy frontend:80
	}
}

#Permiso del on-demand: solo <identificador>.{$PLATFORM_DOMAIN}, con el formato de identificador de las tiendas
#(TenantService.IDENTIFIER). No verifica que la tienda exista. Escucha solo dentro del contenedor
http://localhost:5555 {
	@tienda expression `{query.domain}.endsWith(".{$PLATFORM_DOMAIN}") && {query.domain}.matches("^[a-z][a-z0-9-]{1,28}[a-z0-9][.]")`
	respond @tienda 200
	respond 403
}
