#Configuracion de docker-compose.prod.yml. Copiar a .env (no se commitea) y completar.
#Los valores de ejemplo sirven para probar en local; en el server hay que cambiar todos los secretos.

#Base de datos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar-esto

#Secretos: JWT de los clientes (minimo 32 caracteres) y token interno entre servicios.
#Para generarlos: openssl rand -base64 48
JWT_SECRET=cambiar-esto-por-un-secreto-de-al-menos-32-caracteres
API_INTERNAL_KEY=cambiar-esto-por-otro-secreto-largo

#Plataforma. La URL de cada tienda es <PLATFORM_SCHEME>://<identificador>.<PLATFORM_DOMAIN>
#En local: http y localhost:2999 (los navegadores resuelven *.localhost solos)
#En el server: https y el dominio (ej. midominio.com), con un DNS comodin *.midominio.com. Sin dominio, sslip.io
#resuelve a la IP del server: PLATFORM_DOMAIN=201-32-129-72.sslip.io, PLATFORM_URL=https://201-32-129-72.sslip.io,
#PLATFORM_HOSTNAME=201-32-129-72.sslip.io y PUBLIC_API_URL=https://api.201-32-129-72.sslip.io (Caddy hace el HTTPS)
PLATFORM_SCHEME=http
PLATFORM_DOMAIN=localhost:2999
#URL del frontend de la plataforma (sin tienda) y su host
PLATFORM_URL=http://localhost:2999
PLATFORM_HOSTNAME=localhost
#URL publica del gateway, la que usa el navegador. Queda fija en el build del frontend
PUBLIC_API_URL=http://localhost:3000

#Puertos publicados en la maquina, solo en 127.0.0.1 (en el server la entrada es Caddy, en 80 y 443)
FRONTEND_PORT=2999
GATEWAY_PORT=3000

#Primer superadmin de la plataforma (se crea al arrancar si no existe)
SUPERADMIN_EMAIL=superadmin@kleinkauf.local
SUPERADMIN_PASSWORD=cambiar-esto

#Mail para recuperar la contrasena (con Gmail: contrasena de aplicacion)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tuMail@gmail.com
MAIL_PASSWORD=tu_app_password

#Memoria de cada JVM
JAVA_OPTS=-Xms64m -Xmx256m -XX:+UseSerialGC
