      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (application, status) (rate(http_server_requests_seconds_count{status=~\"4..\"}[5m]))",
          "legendFormat": "{{application}} {{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Requests por tienda (gateway, top 10)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (tenant) (rate(http_server_requests_seconds_count{application=~\"gateway.*\",tenant!=\"none\"}[5m])))",
          "legendFormat": "{{tenant}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
